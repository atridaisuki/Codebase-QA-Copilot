# 应用名称
APP_NAME=Codebase QA Copilot
# 运行环境，例如 development / production
APP_ENV=development
# API 路由前缀；留空表示直接暴露 /health、/ingest、/qa
API_PREFIX=

# 容器内文档目录；docker-compose 会将宿主机 ./data/docs 只读挂载到这里
DEFAULT_DOCS_DIR=data/docs
# Chroma 持久化目录；建议挂载到命名卷以保留索引数据
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=documents
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# 默认检索返回片段数
DEFAULT_TOP_K=3
RETRIEVAL_FETCH_K=6
RETRIEVAL_SCORE_THRESHOLD=0.4
GROUNDED_TOP_SCORE_THRESHOLD=0.5
GROUNDED_AVERAGE_SCORE_THRESHOLD=0.45
GROUNDED_MIN_CHUNKS=1
MAX_CONTEXT_CHARS=3200
ENABLE_RERANK=false
RERANK_TOP_N=3

# 当前支持的 LLM 提供方
LLM_PROVIDER=anthropic
# Anthropic API Key；生产环境请在 .env 或部署平台密钥管理中设置
ANTHROPIC_API_KEY=
# 可选：兼容网关或代理地址；默认留空使用官方 API
ANTHROPIC_BASE_URL=
# 默认使用的 Claude 模型
ANTHROPIC_MODEL=claude-opus-4-6
